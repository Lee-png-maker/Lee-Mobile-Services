<label>Customer Address</label>

<input
type="text"
id="address"
placeholder="Enter your address"
required>

<button type="button" onclick="getLocation()">

📍 Use My Current Location

</button>

<input
type="text"
id="gpsLocation"
placeholder="GPS Coordinates"
readonly><select id="property">

<option>House</option>
<option>Apartment</option>
<option>Office</option>
<option>Business</option>

</select>

<label>Service Address</label>

<input
type="text"
id="address"
placeholder="Enter full address"
required>

<button
type="button"
id="locationBtn">

📍 Use My Current Location

</button>

<label>Upload Photos (Optional)</label>

<input
type="file"
id="photos"
accept="image/*"
multiple>

<label>Special Instructions</label>

<textarea
id="notes"
rows="5"
placeholder="Describe your request..."></textarea>

<h3>Payment Method</h3>

<label>
<input
type="radio"
name="payment"
value="Cash"
checked>
Cash
</label>

<label>
<input
type="radio"
name="payment"
value="EFT">
EFT
</label>

<label>
<input
type="radio"
name="payment"
value="Card">
Card
</label>

<label>
<input
type="radio"
name="payment"
value="iKhokha">
iKhokha
</label>

<br><br>

<button
type="submit"
id="bookBtn">

💬 Book on WhatsApp

</button>

</form>

</section>

<footer>

<p>

📞 068 868 5355

</p>

<p>

© 2026 Lee Mobile Laundry, Car Wash & Cleaning Services

</p>

</footer>

